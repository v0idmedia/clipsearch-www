{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipsearch-telegram-relay",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "secrets": {
    "required": [
      "RELAY_SHARED_SECRET",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "TELEGRAM_MESSAGE_THREAD_ID"
    ]
  }
}
